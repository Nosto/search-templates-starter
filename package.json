    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "style-lint": "stylelint 'src/**/*.css'",
    "style-lint-fix": "stylelint 'src/**/*.css' --fix",
    "preview": "vite preview",
    "prepare": "husky",
    "storybook": "storybook dev -p 6060",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
